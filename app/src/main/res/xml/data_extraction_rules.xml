<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same files for cloud backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="strata/user.json" />
        <include domain="file" path="strata/settings.json" />
        <include domain="file" path="strata/queues.json" />
        <include domain="file" path="strata/positions.json" />
        <include domain="file" path="strata/session.json" />
        <include domain="file" path="strata/now.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="strata/user.json" />
        <include domain="file" path="strata/settings.json" />
        <include domain="file" path="strata/queues.json" />
        <include domain="file" path="strata/positions.json" />
        <include domain="file" path="strata/session.json" />
        <include domain="file" path="strata/now.json" />
    </device-transfer>
</data-extraction-rules>
