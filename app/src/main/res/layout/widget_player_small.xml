<?xml version="1.0" encoding="utf-8"?>
<!-- "Now playing" as a slim 4x1 strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">

    <ViewFlipper
        android:id="@+id/w_info"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:animateFirstView="false"
        android:inAnimation="@anim/widget_info_in"
        android:outAnimation="@anim/widget_info_out">

        <LinearLayout
            android:id="@+id/w_info0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_art0"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Strata"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/w_sub0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Now playing"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_info1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_art1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Strata"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/w_sub1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Now playing"
                    android:textColor="@color/widget_sub"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </ViewFlipper>

    <ViewFlipper
                android:id="@+id/w_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:animateFirstView="false"
                android:contentDescription="Play"
                android:inAnimation="@anim/widget_pop_in"
                android:outAnimation="@anim/widget_pop_out"
                android:background="@drawable/widget_ripple">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_w_play"
                    android:tint="@color/widget_text" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_w_pause"
                    android:tint="@color/widget_text" />
            </ViewFlipper>

    <ImageView
        android:id="@+id/w_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_ripple"
        android:contentDescription="Next track"
        android:padding="11dp"
        android:src="@drawable/ic_w_next"
        android:tint="@color/widget_text" />
</LinearLayout>
