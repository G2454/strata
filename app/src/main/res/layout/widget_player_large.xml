<?xml version="1.0" encoding="utf-8"?>
<!-- "Now playing", 4x2 and up. Everything here changes only on player events: a track change crossfades the
     info block, play/pause and the heart pop, and the elapsed time is a Chronometer the launcher ticks itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <ViewFlipper
        android:id="@+id/w_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateFirstView="false"
        android:inAnimation="@anim/widget_info_in"
        android:outAnimation="@anim/widget_info_out">

        <LinearLayout
            android:id="@+id/w_info0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Fills the row's height (up to 96dp) and stays square, so a short 4x2 cell never clips it. -->
            <ImageView
                android:id="@+id/w_art0"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="96dp"
                android:maxHeight="96dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_art_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Strata"
                    android:textColor="@color/widget_text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/w_sub0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Now playing"
                    android:textColor="@color/widget_sub"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_info1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Fills the row's height (up to 96dp) and stays square, so a short 4x2 cell never clips it. -->
            <ImageView
                android:id="@+id/w_art1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="96dp"
                android:maxHeight="96dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_art_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Strata"
                    android:textColor="@color/widget_text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/w_sub1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Now playing"
                    android:textColor="@color/widget_sub"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </ViewFlipper>

    <LinearLayout
        android:id="@+id/w_time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/w_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/widget_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_pos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/widget_sub"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ViewFlipper
                android:id="@+id/w_fav"
                android:layout_width="44dp"
                android:layout_height="44dp"
            android:layout_gravity="center"
                android:animateFirstView="false"
                android:contentDescription="Add to favorites"
                android:inAnimation="@anim/widget_pop_in"
                android:outAnimation="@anim/widget_pop_out"
                android:background="@drawable/widget_ripple">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_w_heart"
                    android:tint="@color/widget_accent" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_w_heart_fill"
                    android:tint="@color/widget_accent" />
            </ViewFlipper>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView
                android:id="@+id/w_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_ripple"
                android:contentDescription="Previous track"
                android:padding="10dp"
                android:src="@drawable/ic_w_prev"
                android:tint="@color/widget_text" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ViewFlipper
                android:id="@+id/w_play"
                android:layout_width="52dp"
                android:layout_height="52dp"
            android:layout_gravity="center"
                android:animateFirstView="false"
                android:contentDescription="Play"
                android:inAnimation="@anim/widget_pop_in"
                android:outAnimation="@anim/widget_pop_out"
                android:background="@drawable/widget_play_bg">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_w_play"
                    android:tint="@color/widget_on_accent" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_w_pause"
                    android:tint="@color/widget_on_accent" />
            </ViewFlipper>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView
                android:id="@+id/w_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_ripple"
                android:contentDescription="Next track"
                android:padding="10dp"
                android:src="@drawable/ic_w_next"
                android:tint="@color/widget_text" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
