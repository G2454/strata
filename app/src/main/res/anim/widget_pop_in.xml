<?xml version="1.0" encoding="utf-8"?>
<!-- Play/pause and the heart pop in when they change. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@android:anim/overshoot_interpolator">
    <scale
        android:fromXScale="0.4" android:toXScale="1"
        android:fromYScale="0.4" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="140" android:fromAlpha="0" android:toAlpha="1" />
</set>
